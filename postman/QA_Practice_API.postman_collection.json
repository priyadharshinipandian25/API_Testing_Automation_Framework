            "type": "text/javascript",
            "exec": [
              "pm.test(\"Invalid token is rejected\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 - Missing user negative test",
      "request": {
        "method": "GET",
        "header": [
          {
